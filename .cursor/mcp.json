{
  "mcpServers": {
    "context7": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-remote-proxy.sh",
        "https://mcp.context7.com/mcp",
        "CONTEXT7_API_KEY",
        "CONTEXT7_API_KEY",
        "raw"
      ],
      "envFile": "${workspaceFolder}/.devcontainer/.env"
    },
    "cloudflare-api": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-remote-proxy.sh",
        "https://mcp.cloudflare.com/mcp",
        "Authorization",
        "CLOUDFLARE_MCP_TOKEN",
        "bearer"
      ],
      "envFile": "${workspaceFolder}/.devcontainer/.env"
    },
    "kubernetes-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest"
      ]
    },
    "oracle-oci-cloud-mcp-server": {
      "command": "uvx",
      "args": [
        "oracle.oci-cloud-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "OCI_CONFIG_FILE": "${workspaceFolder}/.oci/oci.config",
        "OCI_CONFIG_PROFILE": "ApexCaptain"
      }
    },
    "pulumi": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/mcp-remote-proxy.sh",
        "https://mcp.ai.pulumi.com/mcp",
        "--header",
        "Authorization",
        "PULUMI_ACCESS_TOKEN",
        "bearer",
        "--header",
        "X-Pulumi-Org",
        "PULUMI_APEX_CAPTAIN_ACCOUNT_NAME",
        "raw"
      ],
      "envFile": "${workspaceFolder}/.devcontainer/.env"
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
