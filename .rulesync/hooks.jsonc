// AI 에이전트 hooks SSOT. pnpm ai:generate → .cursor/hooks.json, .claude/settings.json
// 이벤트·입출력 형식이 에이전트마다 달라 공통 hooks 대신 도구별 블록을 쓴다.
{
  "version": 1,
  "hooks": {},
  "cursor": {
    "hooks": {
      "beforeShellExecution": [
        {
          "matcher": "git",
          "command": "scripts/hooks/gitops-git-guard.sh"
        }
      ]
    }
  },
  "claudecode": {
    "hooks": {
      "preToolUse": [
        {
          "matcher": "Bash",
          "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/gitops-git-guard.sh"
        }
      ]
    }
  }
}
