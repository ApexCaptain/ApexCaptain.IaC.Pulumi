{
  "mcpServers": {
    "kubernetes-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest"
      ]
    }
  },
  "cursor": {
    "mcpServers": {
      "cloudflare-api": {
        "type": "stdio",
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/mcp-remote-proxy.sh",
          "https://mcp.cloudflare.com/mcp",
          "Authorization",
          "CLOUDFLARE_MCP_TOKEN",
          "bearer"
        ],
        "envFile": "${workspaceFolder}/.devcontainer/.env"
      },
      "oracle-oci-cloud-mcp-server": {
        "type": "stdio",
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/mcp-oci.sh",
          ".oci/oci.config",
          "ApexCaptain"
        ]
      },
      "pulumi": {
        "type": "stdio",
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/mcp-remote-proxy.sh",
          "https://mcp.ai.pulumi.com/mcp",
          "--header",
          "Authorization",
          "PULUMI_ACCESS_TOKEN",
          "bearer",
          "--header",
          "X-Pulumi-Org",
          "PULUMI_APEX_CAPTAIN_ACCOUNT_NAME",
          "raw"
        ],
        "envFile": "${workspaceFolder}/.devcontainer/.env"
      }
    }
  },
  "claudecode": {
